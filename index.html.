<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>GPT HUB — все диалоги в одном месте</title>
<style>
:root{--bg:#0b0d12;--panel:#12151d;--panel2:#181c26;--line:#252b38;--text:#f4f6fb;--muted:#929bad;--accent:#a78bfa;--accent2:#6ee7d8;--danger:#fb7185}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}
button,input,textarea{font:inherit}button{cursor:pointer;color:inherit}.app{min-height:100vh;display:grid;grid-template-columns:260px 1fr}
.sidebar{border-right:1px solid var(--line);padding:22px 16px;background:#0e1118;display:flex;flex-direction:column;gap:22px}
.brand{display:flex;align-items:center;gap:11px;padding:3px 8px;font-size:18px;font-weight:800;letter-spacing:-.5px}.logo{width:34px;height:34px;border-radius:12px;background:linear-gradient(135deg,#a78bfa,#6ee7d8);display:grid;place-items:center;color:#10121a;font-weight:900}
.primary{border:0;border-radius:12px;background:linear-gradient(110deg,#a78bfa,#7c6cf2);padding:12px 14px;font-weight:700;color:#11121a;box-shadow:0 8px 28px #8b5cf633}
.nav{display:grid;gap:5px}.nav button,.folder{border:0;background:transparent;text-align:left;color:var(--muted);padding:10px 11px;border-radius:10px;display:flex;justify-content:space-between;align-items:center}.nav button.active,.nav button:hover,.folder:hover{background:var(--panel2);color:var(--text)}
.side-label{font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:#657084;padding:0 11px;margin-bottom:4px}.folders{display:grid;gap:3px}.folder{justify-content:flex-start;gap:10px}.dot{width:8px;height:8px;border-radius:50%;background:var(--accent)}
.profile{margin-top:auto;border-top:1px solid var(--line);padding:16px 7px 0;display:flex;align-items:center;gap:10px}.avatar{width:34px;height:34px;border-radius:50%;background:#272d3c;display:grid;place-items:center;font-weight:700}.profile small{display:block;color:var(--muted)}
main{min-width:0;padding:30px clamp(18px,4vw,54px)}.top{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:28px}.eyebrow{color:var(--accent2);font-size:11px;letter-spacing:1.7px;text-transform:uppercase;font-weight:700}.title{font-size:clamp(27px,4vw,38px);letter-spacing:-1.3px;margin:5px 0}.subtitle{color:var(--muted);margin:0}.top-actions{display:flex;gap:9px}.ghost,.smallbtn{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px 13px}.ghost:hover,.smallbtn:hover{border-color:#7770bd}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:24px 0}.stat{background:linear-gradient(145deg,#171b26,#11141c);border:1px solid var(--line);border-radius:15px;padding:16px}.stat strong{font-size:25px;display:block;letter-spacing:-1px}.stat span{color:var(--muted);font-size:12px}
.toolbar{display:flex;gap:10px;align-items:center;margin:24px 0 15px}.search{flex:1;position:relative}.search input{width:100%;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px 12px 40px;color:var(--text);outline:none}.search input:focus{border-color:var(--accent)}.search i{position:absolute;left:14px;top:10px;color:var(--muted);font-style:normal;font-size:17px}
.filters{display:flex;gap:7px;overflow:auto;margin-bottom:14px}.chip{border:1px solid var(--line);background:transparent;color:var(--muted);border-radius:20px;padding:7px 12px;white-space:nowrap;font-size:12px}.chip.active{background:#a78bfa20;border-color:#8b78d8;color:#d9ccff}
.content{display:grid;grid-template-columns:minmax(280px,.9fr) minmax(340px,1.1fr);gap:14px;align-items:start}.chat-list,.preview{background:var(--panel);border:1px solid var(--line);border-radius:16px;overflow:hidden}.list-head,.preview-head{padding:15px 17px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.list-head strong,.preview-head strong{font-size:13px}.count{color:var(--muted);font-size:11px}.chat-item{padding:15px 17px;border-bottom:1px solid #202532;cursor:pointer;transition:.15s}.chat-item:hover,.chat-item.selected{background:#1b2030}.chat-item:last-child{border:0}.chat-title{display:flex;justify-content:space-between;gap:8px;font-weight:650}.chat-meta{color:var(--muted);font-size:11px;margin-top:5px}.chat-snippet{color:#b2bac9;font-size:12px;margin-top:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.tag{font-size:10px;color:var(--accent2);background:#6ee7d815;padding:3px 7px;border-radius:20px}
.preview-body{padding:20px;min-height:300px}.message{padding:13px 14px;border:1px solid var(--line);border-radius:13px;margin:10px 0;background:#171b25}.message.user{background:#1d1b2c;border-color:#393253}.message-label{font-size:10px;color:var(--accent2);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px}.message p{margin:0;color:#dce1eb;white-space:pre-wrap}.empty{color:var(--muted);text-align:center;padding:50px 20px}
.modal-back{position:fixed;inset:0;background:#0009;display:none;align-items:center;justify-content:center;padding:16px;z-index:5}.modal{width:min(520px,100%);background:#151923;border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:0 20px 80px #0009}.modal h3{margin:0 0 14px}.field{display:grid;gap:6px;margin:12px 0}.field label{font-size:12px;color:var(--muted)}.field input,.field textarea{background:#0d1119;border:1px solid var(--line);border-radius:10px;padding:11px;color:var(--text);outline:none;width:100%}.field textarea{min-height:110px;resize:vertical}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:17px}.hint{font-size:11px;color:var(--muted);margin-top:10px}
@media(max-width:850px){.app{grid-template-columns:1fr}.sidebar{display:none}main{padding:22px 14px}.content{grid-template-columns:1fr}.preview{min-height:260px}.stats{gap:8px}.stat{padding:12px}.top{align-items:flex-start}.top-actions .ghost{font-size:12px;padding:9px}.subtitle{font-size:12px}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
 <div class="brand"><div class="logo">G</div> GPT HUB</div>
 <button class="primary" id="newChat">＋ Новый диалог</button>
 <div class="nav">
  <button class="active" data-view="all">▤ Все диалоги <span id="navCount">0</span></button>
  <button data-view="favorites">☆ Избранное</button>
  <button data-view="recent">◷ Недавние</button>
 </div>
 <div><div class="side-label">Мои папки</div><div class="folders">
  <button class="folder" data-folder="Работа"><span class="dot"></span> Работа</button>
  <button class="folder" data-folder="Идеи"><span class="dot" style="background:#fbbf24"></span> Идеи</button>
  <button class="folder" data-folder="Обучение"><span class="dot" style="background:#60a5fa"></span> Обучение</button>
 </div></div>
 <div class="profile"><div class="avatar">A</div><div><b>Мой Workspace</b><small>Локальное хранилище</small></div></div>
</aside>
<main>
 <div class="top"><div><div class="eyebrow">ТВОЁ ПРОСТРАНСТВО ИДЕЙ</div><h1 class="title">Все чаты. Один центр.</h1><p class="subtitle">Собери диалоги, наведи порядок и редактируй всё под себя.</p></div>
 <div class="top-actions"><button class="ghost" id="importBtn">↑ Импорт</button><button class="ghost" id="exportBtn">↓ Экспорт</button><input id="fileInput" type="file" accept=".json,.txt" hidden></div></div>
 <section class="stats"><div class="stat"><strong id="totalStat">0</strong><span>Всего диалогов</span></div><div class="stat"><strong id="favStat">0</strong><span>В избранном</span></div><div class="stat"><strong>100%</strong><span>Твои данные под контролем</span></div></section>
 <div class="toolbar"><div class="search"><i>⌕</i><input id="search" placeholder="Найти чат по названию или содержимому…"></div><button class="smallbtn" id="addFolder">＋ Папка</button></div>
 <div class="filters"><button class="chip active" data-filter="all">Все</button><button class="chip" data-filter="ChatGPT">ChatGPT</button><button class="chip" data-filter="GPTs">Мои GPTs</button><button class="chip" data-filter="Other">Другие</button></div>
 <div class="content">
  <section class="chat-list"><div class="list-head"><strong>Библиотека диалогов</strong><span class="count" id="listCount">0 диалогов</span></div><div id="chatItems"></div></section>
  <section class="preview"><div class="preview-head"><strong id="previewTitle">Предпросмотр диалога</strong><div><button class="smallbtn" id="editBtn">✎ Изменить</button> <button class="smallbtn" id="favBtn">☆</button></div></div><div class="preview-body" id="previewBody"><div class="empty">Выбери диалог слева или создай новый.<br>Твои идеи теперь в одном месте ✨</div></div></section>
 </div>
 <p class="hint">Демо-версия: изменения сохраняются в браузере на этом устройстве. Для объединения истории ChatGPT используй экспорт данных из своего аккаунта и импортируй JSON-файл сюда.</p>
</main></div>
<div class="modal-back" id="modalBack"><div class="modal"><h3 id="modalTitle">Редактировать диалог</h3><div class="field"><label>Название</label><input id="editTitle"></div><div class="field"><label>Папка</label><input id="editFolder" placeholder="Например, Работа"></div><div class="field"><label>Содержание / заметки</label><textarea id="editContent"></textarea></div><div class="modal-actions"><button class="ghost" id="cancel">Отмена</button><button class="primary" id="save">Сохранить</button></div></div></div>
<script>
const seed=[
 {id:1,title:"Идеи для нового проекта",source:"ChatGPT",folder:"Идеи",date:"Сегодня",favorite:true,content:"Собрать все идеи в одном месте и превратить лучшие из них в реальные проекты."},
 {id:2,title:"Контент-план для Reels",source:"Мои GPTs",folder:"Работа",date:"Вчера",favorite:false,content:"План публикаций, сценарии коротких роликов, сильные первые 2 секунды и понятный призыв к действию."},
 {id:3,title:"Изучение новых инструментов",source:"ChatGPT",folder:"Обучение",date:"На этой неделе",favorite:false,content:"Разобраться с инструментами, автоматизацией и новыми рабочими процессами."}
];
let chats=JSON.parse(localStorage.getItem("gpthub_chats")||"null")||seed;
let selected=chats[0]?.id||null, view="all", filter="all";
const $=id=>document.getElementById(id);
function persist(){localStorage.setItem("gpthub_chats",JSON.stringify(chats));render()}
function render(){
 $("totalStat").textContent=chats.length;$("favStat").textContent=chats.filter(x=>x.favorite).length;$("navCount").textContent=chats.length;
 let q=$("search").value.toLowerCase();
 let shown=chats.filter(c=>(view==="all"||(view==="favorites"&&c.favorite)||(view==="recent"&&c.date!=="—"))&&(filter==="all"||c.source===filter)&&(!q||(c.title+" "+c.content+" "+c.folder).toLowerCase().includes(q)));
 $("listCount").textContent=shown.length+" диалогов";
 $("chatItems").innerHTML=shown.length?shown.map(c=>`<div class="chat-item ${c.id===selected?"selected":""}" data-id="${c.id}"><div class="chat-title"><span>${esc(c.title)}</span><span>${c.favorite?"★":""}</span></div><div class="chat-meta">${esc(c.source)} · ${esc(c.folder||"Без папки")} · ${esc(c.date)}</div><div class="chat-snippet">${esc(c.content)}</div></div>`).join(""):'<div class="empty">Ничего не найдено</div>';
 document.querySelectorAll(".chat-item").forEach(el=>el.onclick=()=>{selected=+el.dataset.id;renderPreview();render()});
 renderPreview();
}
function renderPreview(){let c=chats.find(x=>x.id===selected);$("previewTitle").textContent=c?c.title:"Предпросмотр диалога";$("editBtn").disabled=!c;$("favBtn").disabled=!c;$("favBtn").textContent=c?(c.favorite?"★":"☆"):"☆";
 $("previewBody").innerHTML=c?`<div class="message user"><div class="message-label">Диалог / заметка</div><p>${esc(c.content)}</p></div><div class="hint">Источник: ${esc(c.source)} · Папка: ${esc(c.folder||"Без папки")}</div>`:'<div class="empty">Выбери диалог слева или создай новый.</div>'}
function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
function openEditor(c){$("editTitle").value=c?.title||"Новый диалог";$("editFolder").value=c?.folder||"";$("editContent").value=c?.content||"";$("modalTitle").textContent=c?"Редактировать диалог":"Создать диалог";$("modalBack").style.display="flex"}
$("newChat").onclick=()=>{selected=null;openEditor(null)};
$("editBtn").onclick=()=>{let c=chats.find(x=>x.id===selected);if(c)openEditor(c)};
$("cancel").onclick=()=> $("modalBack").style.display="none";
$("save").onclick=()=>{let title=$("editTitle").value.trim()||"Без названия",folder=$("editFolder").value.trim(),content=$("editContent").value.trim();let c=chats.find(x=>x.id===selected);if(c)Object.assign(c,{title,folder,content});else{let id=Date.now();chats.unshift({id,title,folder,content,source:"ChatGPT",date:"Сегодня",favorite:false});selected=id} $("modalBack").style.display="none";persist()};
$("favBtn").onclick=()=>{let c=chats.find(x=>x.id===selected);if(c){c.favorite=!c.favorite;persist()}};
$("search").oninput=render;
document.querySelectorAll("[data-view]").forEach(b=>b.onclick=()=>{view=b.dataset.view;document.querySelectorAll("[data-view]").forEach(x=>x.classList.toggle("active",x===b));render()});
document.querySelectorAll("[data-filter]").forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll("[data-filter]").forEach(x=>x.classList.toggle("active",x===b));render()});
document.querySelectorAll("[data-folder]").forEach(b=>b.onclick=()=>{$("search").value=b.dataset.folder;view="all";render()});
$("addFolder").onclick=()=>{let f=prompt("Название новой папки:");if(f?.trim()){let b=document.createElement("button");b.className="folder";b.innerHTML='<span class="dot" style="background:#f472b6"></span>'+esc(f.trim());b.onclick=()=>{$("search").value=f.trim();render()};document.querySelector(".folders").append(b)}};
$("exportBtn").onclick=()=>{let blob=new Blob([JSON.stringify(chats,null,2)],{type:"application/json"}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="gpt-hub-chats.json";a.click();URL.revokeObjectURL(a.href)};
$("importBtn").onclick=()=>$("fileInput").click();
$("fileInput").onchange=async e=>{let f=e.target.files[0];if(!f)return;try{let data=JSON.parse(await f.text());let arr=Array.isArray(data)?data:(data.conversations||data.chats||[]);if(!Array.isArray(arr))throw Error();let imported=arr.map((x,i)=>({id:Date.now()+i,title:x.title||x.name||"Импортированный диалог",source:"ChatGPT",folder:"Импорт",date:"Импорт",favorite:false,content:typeof x.content==="string"?x.content:typeof x.messages==="string"?x.messages:JSON.stringify(x.messages||x.mapping||x).slice(0,5000)}));chats=[...imported,...chats];persist();alert("Импортировано диалогов: "+imported.length)}catch(err){alert("Не удалось прочитать JSON. Выбери экспорт ChatGPT или JSON-массив диалогов.")}e.target.value=""};
render();
</script></body></html>
